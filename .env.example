# Copy to .env and fill in. On Vercel, add these under Project → Settings → Environment Variables.

# PostgreSQL connection string (Neon / Supabase)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin login (username + email + password)
ADMIN_USERNAME="admin"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Secret path of the admin dashboard (folder app/<this>)
ADMIN_PATH="kp-control-92hx"

# Session signing secret — use a long random string
AUTH_SECRET="generate-a-long-random-string"

# Claude AI advisor
ANTHROPIC_API_KEY=""

# PayPlus payment gateway
PAYPLUS_API_URL="https://restapidev.payplus.co.il/api/v1.0"
PAYPLUS_API_KEY=""
PAYPLUS_SECRET_KEY=""
PAYPLUS_PAYMENT_PAGE_UID=""

# Public site URL (your domain in production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Shipping
NEXT_PUBLIC_FREE_SHIPPING_OVER="199"
NEXT_PUBLIC_SHIPPING_FEE="25"
